# ─────────────────────────────────────────────────────────────────────
# YantraTech Admin — environment template
#
# Copy to `.env` and adjust:  cp .env.example .env
# `.env` is gitignored; this file is committed as the reference.
#
# ⚠ Every YT_/VITE_ prefixed value is inlined into the client bundle at
#   build time and is publicly readable in the browser. Never put
#   secrets, API keys, passwords, or tokens in here.
# ─────────────────────────────────────────────────────────────────────

# Backend base URL, used by PRODUCTION builds only.
# In dev this is ignored: API_BASE_URL resolves to '' so requests go to
# the relative /api path and are proxied (see YT_DEV_PROXY_TARGET below),
# which sidesteps CORS.
YT_API_BASE_URL=https://api.yantravidyainfotech.com

# Axios request timeout in milliseconds.
YT_API_TIMEOUT=30000

# Where `npm run dev` forwards /api requests. Defaults to the live API.
# Point it at a local Django backend when developing against one:
#   YT_DEV_PROXY_TARGET=http://127.0.0.1:8000
YT_DEV_PROXY_TARGET=https://api.yantravidyainfotech.com
